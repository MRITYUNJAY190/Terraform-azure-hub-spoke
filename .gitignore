# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Terraform lock file - DO NOT ignore
# .terraform.lock.hcl

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Terraform plan files
*.tfplan

# Ignore all tfvars files
*.tfvars
*.tfvars.json

# Allow terraform.tfvars for practical
!terraform.tfvars
